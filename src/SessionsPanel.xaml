<Window x:Class="Assist.SessionsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computah sessions" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Opacity="0" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#ECECEE"/>
        <SolidColorBrush x:Key="Muted" Color="#8C8C96"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#40FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#5CE1FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#1A5CE1FF" Padding="10,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#335CE1FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="16" Background="#1C1C21">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="16" Background="#1C1C21" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="10,12,10,10">
            <StackPanel>
                <Grid Margin="6,0,2,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sessions" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Count" Foreground="{StaticResource Muted}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="New_Click" ToolTip="Start a new session (Alt+A)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="New" Margin="6,0,0,1" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="List"/>
                </ScrollViewer>

                <TextBlock x:Name="Empty" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="12,14,12,16" Visibility="Collapsed"
                           Text="No sessions yet. Press Alt+A anywhere to start one."/>

                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="6,8,6,0"
                           Text="Click to target it with Ctrl+Alt+A · Double-click to open"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
