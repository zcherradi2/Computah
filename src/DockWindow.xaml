<Window x:Class="Assist.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computah" Width="96" Height="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid x:Name="Root" Cursor="Hand" ToolTip="Computah: click for sessions, drag to move"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <!-- just the face; its shadow turns into a cyan glow while an agent is answering -->
        <Image x:Name="Face" Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <DropShadowEffect x:Name="Glow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
            </Image.Effect>
        </Image>

        <!-- session count, on the top-right corner of the screen -->
        <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,3,0"
                MinWidth="20" Height="20" CornerRadius="10" Background="#5CE1FF" Padding="5,0"
                BorderBrush="#16171F" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="BadgeText" FontSize="10.5" FontWeight="Bold" Foreground="#0B1220"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
        </Border>
    </Grid>
</Window>
