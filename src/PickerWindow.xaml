<Window x:Class="Assist.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computah" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#ECECEE"/>
        <SolidColorBrush x:Key="Muted" Color="#8C8C96"/>
        <SolidColorBrush x:Key="Accent" Color="#5CE1FF"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#5CE1FF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#8AEBFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="18" Background="#1C1C21">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="18" Background="#1C1C21" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="24,22,24,18">
            <StackPanel>
                <Grid MouseLeftButtonDown="Drag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Logo" Width="52" Height="52" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="14,2,0,0">
                        <TextBlock Text="Welcome to Computah" Foreground="{StaticResource Fg}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Choose the AI agent that answers when you press Alt&#x2060;+&#x2060;A."/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="AGENTS FOUND ON THIS PC" Foreground="{StaticResource Muted}" FontSize="11"
                           FontWeight="SemiBold" Margin="2,22,0,8"/>
                <StackPanel x:Name="List"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Hint" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="2,0,12,0" Text="You can change this later from the tray icon."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,6,0"/>
                        <Button x:Name="UseBtn" Style="{StaticResource PrimaryButton}" Content="Continue" Click="Use_Click" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
